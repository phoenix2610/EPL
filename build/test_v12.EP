### EPL v1.2 Test — String Ops, Formatting, Type Checks ###

describe test as "Validates all v1.2 features: string ops, formatting, type checks"

# ── String Operations ─────────────────────────────────────

set name as "  Phoenix Developer  "

set upper as name in uppercase
show "Uppercase: " + upper

set lower as name in lowercase
show "Lowercase: " + lower

set trimmed name as name trimmed
show "Trimmed: " + trimmed name

set sentence as "the quick brown fox"
set words as sentence split by " "
show "Split: " + words
show "Word count: " + length of words

set joined back as words joined by "-"
show "Joined: " + joined back

set fixed as "hello world hello" with "hello" replaced by "EPL"
show "Replaced: " + fixed

set starts result as name starts with "  Ph"
show "Starts with: " + starts result

set ends result as name ends with "er  "
show "Ends with: " + ends result

set has dev as name contains "Developer"
show "Contains Developer: " + has dev

# ── Number Formatting ────────────────────────────────────

set price as 19.99
set salary as 75000
set ratio as 87.5
set pi as 3.14159265

show price as currency
show salary as currency
show ratio as percentage
show pi rounded to 2
show pi rounded to 4
show salary as formatted

set big number as 1000000
show big number as formatted

# ── Type Checking ────────────────────────────────────────

set age as 25
set username as "Tathya"
set flags as [true, false, true]
set nothing as null

if age is a number then
    show "age is a number - correct"
!

if username is a string then
    show "username is a string - correct"
!

if flags is a list then
    show "flags is a list - correct"
!

if nothing is a number then
    show "WRONG"
otherwise
    show "nothing is not a number - correct"
!

# ── Combined: Real world use case ────────────────────────

describe student report as "Generates a formatted report for a student"

set student name as "  alice johnson  "
set raw score as 87.456
set max score as 100

set clean name as student name trimmed
set proper name as clean name in uppercase
set score pct as raw score as percentage
set score rounded as raw score rounded to 1
set grade as "A" if raw score at least 90 otherwise "B" if raw score at least 80 otherwise "C"

show "=== Student Report ==="
show "Name:       " + proper name
show "Score:      " + score rounded + " / " + max score
show "Percentage: " + score pct
show "Grade:      " + grade

show ""
show "All v1.2 tests complete!"
