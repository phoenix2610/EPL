describe dashboard as "ARES | Planetary Command"

# ── Planetary Data Models ──────────────────────────────────────────
set fac_names    as ["Aegis Prime", "Vanguard Sec-4", "Titan Foundry", "Helios Array", "Nova Reactor", "Zenith Hub", "Apex Core"]
set fac_output   as [12450, 9820, 15030, 8400, 11200, 14500, 18900]
set fac_targets  as [12000, 10000, 14000, 8500, 11000, 14000, 18000]

set sec_zones    as ["Sector 1", "Sector 2", "Sector 3", "Sector 4", "Sector 5", "Sector 6", "Sector 7"]
set sec_threats  as [12, 4, 34, 0, 8, 21, 5]
set sec_patrols  as [40, 40, 50, 20, 30, 45, 20]

set en_sources   as ["Solar Flux", "Geothermal", "Quantum Core", "Fusion K-2", "Hydro-Kinetic"]
set en_output    as [450, 320, 1850, 2200, 140]
set en_capacity  as [500, 350, 2000, 2500, 200]

set timeline     as ["00:00", "04:00", "08:00", "12:00", "16:00", "20:00", "24:00"]
set load_curve   as [42, 38, 75, 92, 88, 65, 45]
set temp_curve   as [300, 295, 310, 345, 330, 315, 305]

# ═════════════════════════════════════════════════════════════════
#   PAGE 1 — GLOBAL NEXUS (3D COMMAND)
# ═════════════════════════════════════════════════════════════════
make page saved as "ares_global.html" styled as "dark"
    paragraph "<style>.epl-paragraph:has(style){display:none!important;}</style>"
    paragraph "<style>.epl-page{max-width:98vw!important;margin:0 auto;padding:1rem 2rem;}</style>"
    paragraph "<style>.epl-row{grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:2.5rem;}</style>"
    paragraph "<style>.epl-stat{padding:2.5rem;border-radius:20px;border:1px solid rgba(34,211,238,0.15);}</style>"
    paragraph "<style>.epl-stat-value{font-size:3.8rem;text-shadow:0 0 20px rgba(34,211,238,0.4);}</style>"
    paragraph "<style>.epl-section{border-radius:24px;padding:3rem;background:linear-gradient(135deg,rgba(15,23,42,0.8),rgba(0,0,0,0.95));}</style>"
    paragraph "<style>.epl-section{border:1px solid rgba(34,211,238,0.2);box-shadow:0 20px 50px rgba(0,0,0,0.6),inset 0 0 40px rgba(34,211,238,0.04);}</style>"
    paragraph "<style>h1{font-size:4.5rem;letter-spacing:0.05em;background:linear-gradient(90deg,#22d3ee,#818cf8,#c084fc);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:0.5rem;}</style>"
    paragraph "<style>h2{font-size:1.8rem;letter-spacing:0.2em;color:#cbd5e1;margin-bottom:2.5rem;}</style>"
    paragraph "<style>.epl-chart-wrap canvas{height:420px!important;max-height:600px;}table{font-size:1.15rem;}</style>"
    paragraph "<style>th{font-size:0.9rem;padding:1.2rem;background:rgba(34,211,238,0.1);color:#22d3ee;}td{padding:1.2rem;}</style>"
    
    heading "A.R.E.S. COMMAND"
    subheading "Autonomous Resource & Execution System — Global Overview"
    paragraph "Live planetary telemetry. Full responsive modulus engaged. Edge-to-edge rendering."
    divider

    canvas3d "PLANETARY COMMAND GRID" background "deep space"
        core star color "cyan" labeled "A.R.E.S. Neural Core"
        
        orbital ring radius 100 color "blue" speed 0.015
            node at 0.0 labeled "Uplink Alpha" status "completed"
            node at 2.0 labeled "Uplink Beta" status "inprogress"
            node at 4.0 labeled "Uplink Gamma" status "completed"
            node at 5.5 labeled "Uplink Delta" status "completed"
        !
        
        orbital ring radius 180 color "amber" speed 0.005
            node at 1.0 labeled "Aegis Prime" status "completed"
            node at 3.0 labeled "Titan Foundry" status "completed"
            node at 5.0 labeled "Nova Reactor" status "pending"
        !
        
        orbital ring radius 280 color "red" speed 0.001
            node at 0.5 labeled "Threat Vector 1" status "inprogress"
            node at 2.5 labeled "Intrusion Alert" status "overdue"
            node at 4.5 labeled "Anomaly Zeta" status "overdue"
        !
    !

    section "Core Telemetry & Live Diagnostics"
        row
            make stat "System Uptime"  from 99.99
            make stat "Active Nodes"   from 8402
            make stat "Global Threat"  from 12
            make stat "Net Output"     from 90300
            make stat "Energy Draw"    from 4960
        !
    !
!

# ═════════════════════════════════════════════════════════════════
#   PAGE 2 — TITAN FOUNDRIES
# ═════════════════════════════════════════════════════════════════
make page saved as "ares_production.html" styled as "dark"
    paragraph "<style>.epl-paragraph:has(style){display:none!important;}</style>"
    paragraph "<style>.epl-page{max-width:98vw!important;margin:0 auto;padding:1rem 2rem;}</style>"
    paragraph "<style>.epl-row{grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:2.5rem;}</style>"
    paragraph "<style>.epl-stat{padding:2.5rem;border-radius:20px;border:1px solid rgba(34,211,238,0.15);}</style>"
    paragraph "<style>.epl-stat-value{font-size:3.8rem;text-shadow:0 0 20px rgba(34,211,238,0.4);}</style>"
    paragraph "<style>.epl-section{border-radius:24px;padding:3rem;background:linear-gradient(135deg,rgba(15,23,42,0.8),rgba(0,0,0,0.95));}</style>"
    paragraph "<style>.epl-section{border:1px solid rgba(34,211,238,0.2);box-shadow:0 20px 50px rgba(0,0,0,0.6),inset 0 0 40px rgba(34,211,238,0.04);}</style>"
    paragraph "<style>h1{font-size:4.5rem;letter-spacing:0.05em;background:linear-gradient(90deg,#22d3ee,#818cf8,#c084fc);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:0.5rem;}</style>"
    paragraph "<style>h2{font-size:1.8rem;letter-spacing:0.2em;color:#cbd5e1;margin-bottom:2.5rem;}</style>"
    paragraph "<style>.epl-chart-wrap canvas{height:420px!important;max-height:600px;}table{font-size:1.15rem;}</style>"
    paragraph "<style>th{font-size:0.9rem;padding:1.2rem;background:rgba(34,211,238,0.1);color:#22d3ee;}td{padding:1.2rem;}</style>"

    heading "TITAN FOUNDRIES"
    subheading "Planetary Manufacturing & Output Metrics"
    paragraph "Real-time production values across all 7 global megastructures."
    divider

    section "Production Output vs Target Baselines"
        make bar chart for x axis as fac_names and y axis as fac_output titled "Live Output (Units)"
        make line chart for x axis as fac_names and y axis as fac_targets titled "Target Baselines"
    !

    section "Energy Grid Load Distribution"
        row
            make bar chart for x axis as en_sources and y axis as en_output titled "Current Generation (GW)"
            make line chart for x axis as en_sources and y axis as en_capacity titled "Max Capacity (GW)"
        !
    !

    section "Facility Status Ledger"
        make table from fac_names titled "Facility Network Registry"
        make report from fac_output titled "Production Yield Data"
    !
!

# ═════════════════════════════════════════════════════════════════
#   PAGE 3 — THREAT VECTOR ANALYSIS
# ═════════════════════════════════════════════════════════════════
make page saved as "ares_security.html" styled as "dark"
    paragraph "<style>.epl-paragraph:has(style){display:none!important;}</style>"
    paragraph "<style>.epl-page{max-width:98vw!important;margin:0 auto;padding:1rem 2rem;}</style>"
    paragraph "<style>.epl-row{grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:2.5rem;}</style>"
    paragraph "<style>.epl-stat{padding:2.5rem;border-radius:20px;border:1px solid rgba(34,211,238,0.15);}</style>"
    paragraph "<style>.epl-stat-value{font-size:3.8rem;text-shadow:0 0 20px rgba(34,211,238,0.4);}</style>"
    paragraph "<style>.epl-section{border-radius:24px;padding:3rem;background:linear-gradient(135deg,rgba(15,23,42,0.8),rgba(0,0,0,0.95));}</style>"
    paragraph "<style>.epl-section{border:1px solid rgba(34,211,238,0.2);box-shadow:0 20px 50px rgba(0,0,0,0.6),inset 0 0 40px rgba(34,211,238,0.04);}</style>"
    paragraph "<style>h1{font-size:4.5rem;letter-spacing:0.05em;background:linear-gradient(90deg,#22d3ee,#818cf8,#c084fc);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:0.5rem;}</style>"
    paragraph "<style>h2{font-size:1.8rem;letter-spacing:0.2em;color:#cbd5e1;margin-bottom:2.5rem;}</style>"
    paragraph "<style>.epl-chart-wrap canvas{height:420px!important;max-height:600px;}table{font-size:1.15rem;}</style>"
    paragraph "<style>th{font-size:0.9rem;padding:1.2rem;background:rgba(34,211,238,0.1);color:#22d3ee;}td{padding:1.2rem;}</style>"

    heading "THREAT VECTOR ANALYSIS"
    subheading "Sector Intrusion & Defense Patrols"
    paragraph "Automated defense grid tracking, anomaly resolution, and thermal monitoring."
    divider

    section "Sector Security Load"
        make bar chart for x axis as sec_zones and y axis as sec_threats titled "Active Intrusions"
        make line chart for x axis as sec_zones and y axis as sec_patrols titled "Deployed Patrol Units"
    !

    section "Thermal & System Load (24H Matrix)"
        row
            make line chart for x axis as timeline and y axis as load_curve titled "System Load (%)"
            make line chart for x axis as timeline and y axis as temp_curve titled "Core Temp (K)"
        !
    !
!