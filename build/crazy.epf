make page saved as "epl_landing.html" styled as "dark"

    paragraph "<style>.epl-paragraph:has(style),.epl-paragraph:has(script){display:none!important;}</style>"
    paragraph "<style>body{background:#0a0a0a!important;color:#ededed!important;font-family:'Inter',sans-serif;}</style>"
    paragraph "<style>.epl-shell-sidebar{display:none!important;}</style>"
    paragraph "<style>.epl-shell-main{margin-left:0!important;width:100%!important;background:#0a0a0a!important;}</style>"
    paragraph "<style>.epl-top-nav{background:rgba(10,10,10,0.8)!important;border-bottom:1px solid #222!important;backdrop-filter:blur(10px);}</style>"
    paragraph "<style>.epl-page{max-width:1100px!important;margin:0 auto;padding:2rem 2rem 6rem;}</style>"

    paragraph "<style>.nav-brand{font-weight:700;font-size:1.2rem;letter-spacing:0.1em;color:#fff;}</style>"
    paragraph "<style>.nav-status{color:#666;font-size:0.9rem;}</style>"
    paragraph "<style>.pulse{background:#fff!important;box-shadow:0 0 10px #fff!important;}</style>"
    paragraph "<span style='position:fixed;top:18px;left:50%;transform:translateX(-50%);z-index:9999;display:flex;gap:3rem;'>"
    paragraph "<a href='epl_landing.html' style='color:#fff;text-decoration:none;'>Home</a>"
    paragraph "<a href='epl_architecture.html' style='color:#fff;text-decoration:none;'>Architecture</a>"
    paragraph "<a href='epl_signup.html' style='color:#fff;text-decoration:none;'>Early Access</a>"
    paragraph "</span>"

    paragraph "<style>.hero{text-align:center;padding:6rem 0 5rem;perspective:1000px;}</style>"
    paragraph "<style>.hero img{width:160px;margin-bottom:2rem;transform-style:preserve-3d;transition:transform 0.1s;}</style>"
    paragraph "<style>.hero h1{font-size:5.5rem;letter-spacing:-0.04em;background:linear-gradient(180deg,#fff,#555);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:1.5rem;}</style>"
    paragraph "<style>.hero p{font-size:1.4rem;color:#888;max-width:700px;margin:0 auto 3rem;line-height:1.6;}</style>"
    paragraph "<style>.cta-button{display:inline-block;background:#fff;color:#000;padding:1rem 2.5rem;border-radius:30px;font-size:1.1rem;font-weight:600;transition:all 0.2s;cursor:pointer;text-decoration:none;}</style>"
    paragraph "<style>.cta-button:hover{transform:translateY(-3px);box-shadow:0 4px 20px rgba(255,255,255,0.4);}</style>"
    paragraph "<style>.cta-button:active{transform:translateY(0) scale(0.98);}</style>"

    paragraph "<style>.card{background:#050505;padding:2.5rem;border-radius:12px;border:1px solid #222;text-align:left;transition:all 0.3s;}</style>"
    paragraph "<style>.card:hover{background:#111;border-color:#555;transform:translateY(-5px);box-shadow:0 10px 30px rgba(0,0,0,0.8);}</style>"
    paragraph "<style>.card h3{color:#fff;margin-top:0;font-size:1.4rem;margin-bottom:1rem;font-weight:600;}</style>"
    paragraph "<style>.card p{color:#888;font-size:1.05rem;line-height:1.6;margin:0;}</style>"
    paragraph "<style>.epl-row{grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:2.5rem;margin-bottom:2rem;display:grid;}</style>"
    
    # SPIN ON SCROLL JS
    paragraph "<script>window.addEventListener('scroll',()=>{let img=document.querySelector('.hero img');if(img)img.style.transform='rotateY('+(window.scrollY*0.8)+'deg)';});</script>"

    paragraph "<span class='hero' style='display:block;'>"
    paragraph "<img src='../documentation/EPL_logo.png' />"
    paragraph "<h1>Code Like You Speak.</h1>"
    paragraph "<p>The first fully semantic, plain-English programming language designed for enterprise logic, zero-boilerplate development, and high-performance C-compilation.</p>"
    paragraph "<a href='epl_signup.html' class='cta-button'>Request Early Access</a>"
    paragraph "</span>"

    paragraph "<span class='epl-row'>"
    paragraph "<span class='card' style='display:block;'><h3>Semantic Parser</h3><p>Reads pure English and converts it to high-performance Abstract Syntax Trees natively.</p></span>"
    paragraph "<span class='card' style='display:block;'><h3>Native Web Engine</h3><p>Bypasses traditional frameworks. Compiles direct to HTML/JS/CSS automatically.</p></span>"
    paragraph "<span class='card' style='display:block;'><h3>Zero Garbage</h3><p>Intelligent orphan-sweeping tracking. Never leaks files across compilations.</p></span>"
    paragraph "</span>"

!

