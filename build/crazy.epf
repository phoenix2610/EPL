describe dashboard as "EPL | The Future of Code"

set speedup       as 400
set readability   as 98.5
set zero_syntax   as 100

make page saved as "epl_landing.html" styled as "dark"

    # --- CSS INJECTIONS ---
    paragraph "<style>.epl-paragraph:has(style){display:none!important;}</style>"
    paragraph "<style>body{background:#0a0a0a!important;color:#ededed!important;font-family:'Inter',sans-serif;}</style>"
    paragraph "<style>.epl-shell-sidebar{display:none!important;}</style>"
    paragraph "<style>.epl-shell-main{margin-left:0!important;width:100%!important;background:#0a0a0a!important;}</style>"
    paragraph "<style>.epl-top-nav{background:rgba(10,10,10,0.8)!important;border-bottom:1px solid #222!important;backdrop-filter:blur(10px);}</style>"
    paragraph "<style>.epl-page{max-width:1100px!important;margin:0 auto;padding:2rem 2rem 6rem;}</style>"
    
    paragraph "<style>.hero{text-align:center;padding:6rem 0 5rem;}</style>"
    paragraph "<style>.hero img{width:140px;margin-bottom:2rem;animation:float 6s ease-in-out infinite;}</style>"
    paragraph "<style>.hero h1{font-size:5rem;letter-spacing:-0.04em;background:linear-gradient(180deg,#fff,#666);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:1.5rem;}</style>"
    paragraph "<style>.hero p{font-size:1.4rem;color:#888;max-width:650px;margin:0 auto 3rem;line-height:1.6;}</style>"
    paragraph "<style>.cta-button{display:inline-block;background:#fff;color:#000;padding:1rem 2.5rem;border-radius:30px;font-size:1.1rem;font-weight:600;transition:all 0.2s;cursor:pointer;}</style>"
    paragraph "<style>.cta-button:hover{transform:translateY(-2px);box-shadow:0 4px 20px rgba(255,255,255,0.3);}</style>"
    paragraph "<style>.cta-button:active{transform:translateY(0) scale(0.98);}</style>"
    paragraph "<style>@keyframes float{0%{transform:translateY(0px);}50%{transform:translateY(-10px);}100%{transform:translateY(0px);}}</style>"
    
    paragraph "<style>.epl-section{background:#0f0f0f;border:1px solid #222;border-radius:12px;padding:3rem;transition:all 0.3s ease;margin-bottom:3rem;}</style>"
    paragraph "<style>.epl-section:hover{border-color:#444;box-shadow:0 10px 40px rgba(0,0,0,0.5);}</style>"
    paragraph "<style>h2{font-size:2rem;letter-spacing:-0.02em;color:#fff;margin-bottom:2rem;border-bottom:none;text-transform:none;}</style>"
    
    paragraph "<style>.epl-stat{background:#050505;border:1px solid #222;border-radius:8px;padding:2.5rem;transition:all 0.3s ease;text-align:center;cursor:pointer;}</style>"
    paragraph "<style>.epl-stat:hover{background:#111;border-color:#666;transform:translateY(-4px);box-shadow:0 8px 30px rgba(255,255,255,0.05);}</style>"
    paragraph "<style>.epl-stat-value{font-size:3.5rem;font-weight:700;color:#fff;letter-spacing:-0.03em;}</style>"
    paragraph "<style>.epl-stat-label{color:#888;font-size:0.9rem;text-transform:uppercase;letter-spacing:0.1em;margin-top:0.8rem;}</style>"
    paragraph "<style>.epl-row{grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:2.5rem;margin-bottom:2rem;}</style>"
    
    paragraph "<style>.card{background:#050505;padding:2.5rem;border-radius:12px;border:1px solid #222;text-align:left;cursor:pointer;transition:all 0.3s;}</style>"
    paragraph "<style>.card:hover{background:#111;border-color:#555;transform:translateY(-5px);}</style>"
    paragraph "<style>.card:active{transform:translateY(0);border-color:#fff;}</style>"
    paragraph "<style>.card h3{color:#fff;margin-top:0;font-size:1.4rem;margin-bottom:1rem;font-weight:600;}</style>"
    paragraph "<style>.card p{color:#888;font-size:1.05rem;line-height:1.6;margin:0;}</style>"
    
    paragraph "<style>.nav-brand { font-weight: 700; font-size: 1.2rem; letter-spacing: 0.1em; color: #fff; }</style>"
    paragraph "<style>.nav-status { color: #666; font-size: 0.9rem; }</style>"
    paragraph "<style>.pulse { background: #fff !important; box-shadow: 0 0 10px #fff !important; }</style>"

    # ── HERO SECTION ──
    paragraph "<span class='hero' style='display:block;'>"
    paragraph "<img src='../documentation/EPL_logo.png' />"
    paragraph "<h1>Code Like You Speak.</h1>"
    paragraph "<p>The first fully semantic, plain-English language designed for zero-boilerplate development.</p>"
    paragraph "<span class='cta-button' onclick='alert(\"Downloading EPL v1.6...\")'>Download v1.6</span>"
    paragraph "</span>"
    
    # ── FEATURE CARDS ──
    paragraph "<span class='epl-row' style='display:grid;'>"
    paragraph "<span class='card' style='display:block;'><h3>Semantic Parser</h3><p>Translates English to C binaries.</p></span>"
    paragraph "<span class='card' style='display:block;'><h3>Native Dashboards</h3><p>Compile logic directly to UI.</p></span>"
    paragraph "<span class='card' style='display:block;'><h3>Memory Safe</h3><p>Built-in orphan sweeping engine.</p></span>"
    paragraph "</span>"

    # ── NATIVE EPL METRICS ──
    section "Unprecedented Efficiency"
        row
            make stat "Development Speedup %" from speedup
            make stat "Readability Score" from readability
            make stat "Zero Syntax Errors" from zero_syntax
        !
    !

    # ── CHART DATA ──
    set langs as ["C++", "Java", "Python", "EPL v1.6"]
    set read_idx as [24, 45, 82, 100]
    
    section "Comparative Benchmarks"
        make bar chart for x axis as langs and y axis as read_idx titled "Language Readability Index"
    !

!