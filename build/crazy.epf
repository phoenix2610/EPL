describe dashboard as "Next-Gen IIoT Analytics Platform | Pitch Prototype v2.0"

### APEX INDUSTRIAL SYSTEMS - PITCH DECK DASHBOARD
  Theme: dark | Zone: Global Operations | Purpose: Pitch Demo
###

# ── Global Metrics ───────────────────────────────────────────────────
set global_uptime  as 99.98
set active_nodes   as 2048
set anomalies      as 3
set energy_eff     as 84.5
set latency        as 12

# ── Factory Outputs ──────────────────────────────────────────────────
set fac_names    as ["Berlin Gigafactory", "Tokyo Plant", "Nevada Hub", "Shanghai Sector 4"]
set fac_output   as [4200, 3850, 5100, 6200]
set fac_targets  as [4000, 4000, 5000, 6000]

# ── Logistics & Fleet ────────────────────────────────────────────────
set fleet_total  as 340
set fleet_active as 312
set fleet_maint  as 28
set fleet_eff    as fleet_active divided by fleet_total
set deliveries   as 12040

# ── Predictive Maintenance ───────────────────────────────────────────
set risk_assets  as 14
set mtbf         as 8640
set mttr         as 42
set health       as 98.4

# ── Financials ───────────────────────────────────────────────────────
set rev_q1       as 14.2
set rev_q2       as 18.5
set rev_q3       as 21.1
set rev_q4       as 24.8
set quarters     as ["Q1", "Q2", "Q3", "Q4"]
set rev_trend    as [14.2, 18.5, 21.1, 24.8]
set margins      as [12.1, 14.5, 16.8, 19.2]

# ═════════════════════════════════════════════════════════════════
#   PAGE 1 — GLOBAL HUB (3D NEXUS)
# ═════════════════════════════════════════════════════════════════

make page saved as "pitch_hub.html" styled as "dark"

    canvas3d "APEX GLOBAL HUB" background "deep-space"
        core star color "cyan" labeled "Central Neural Core"

        # Ring 1 - Edge Computing Nodes
        orbital ring radius 60 color "blue" speed 0.015
            node at 0.0 labeled "Edge Server Alpha" status "completed"
            node at 2.0 labeled "Edge Server Beta"  status "completed"
            node at 4.0 labeled "Edge Server Gamma" status "completed"
        !

        # Ring 2 - Global Gigafactories
        orbital ring radius 120 color "gold" speed 0.008
            node at 0.5 labeled "Berlin Gigafactory" status "completed"
            node at 2.5 labeled "Tokyo Plant"        status "inprogress"
            node at 4.5 labeled "Nevada Hub"         status "completed"
            node at 6.0 labeled "Shanghai Sector 4"  status "completed"
        !

        # Ring 3 - Satellite Uplinks
        orbital ring radius 180 color "purple" speed 0.003
            node at 1.0 labeled "Uplink SAT-1" status "completed"
            node at 3.0 labeled "Uplink SAT-2" status "inprogress"
            node at 5.0 labeled "Uplink SAT-3" status "pending"
        !

        # Ring 4 - Anomaly Detection Grid
        orbital ring radius 250 color "red" speed 0.001
            node at 1.5 labeled "Sector 7 Intrusion" status "inprogress"
            node at 4.5 labeled "Thermal Spike P3"   status "pending"
        !
    !

    panel "right"
        heading "Global Network Overview"
        subheading "Live telemetry from 2048 active nodes."
        
        make stat "Global Uptime" from global_uptime rounded to 2
        make stat "Active Nodes"  from active_nodes
        make stat "Active Anomalies" from anomalies
        make stat "Network Latency"  from latency
        make stat "Energy Efficiency" from energy_eff rounded to 1
    !

!

# ═════════════════════════════════════════════════════════════════
#   PAGE 2 — PRODUCTION ANALYTICS
# ═════════════════════════════════════════════════════════════════

make page saved as "pitch_production.html" styled as "dark"

    heading "Production Analytics"
    subheading "Live Throughput & Output vs Target Metrics"
    paragraph "Global manufacturing telemetry aggregated via secure edge nodes."
    divider

    section "Throughput Snapshot"
        row
            make stat "Total Global Output" from 19350
            make stat "Target Adherence"    from 1.018 rounded to 2
            make stat "Global Uptime %"     from global_uptime
            make stat "Anomalies Detected"  from anomalies
        !
    !

    section "Factory Performance Metrics"
        make bar chart for x axis as fac_names and y axis as fac_output titled "Actual Production Volume"
        make line chart for x axis as fac_names and y axis as fac_targets titled "Production Targets"
    !

    section "Detailed Factory Directory"
        make table from fac_names titled "Facility Information"
        make report from fac_output titled "Current Output (Units)"
    !

!

# ═════════════════════════════════════════════════════════════════
#   PAGE 3 — LOGISTICS & FLEET
# ═════════════════════════════════════════════════════════════════

make page saved as "pitch_logistics.html" styled as "dark"

    heading "Global Supply Chain & Logistics"
    subheading "Autonomous Fleet Tracking & Delivery Metrics"
    paragraph "Real-time routing and maintenance tracking for autonomous logistics."
    divider

    section "Fleet Overview"
        row
            make stat "Total Vehicles"  from fleet_total
            make stat "Active Fleet"    from fleet_active
            make stat "In Maintenance"  from fleet_maint
            make stat "Fleet Readiness" from fleet_eff rounded to 2
            make stat "Completed Deliveries" from deliveries
        !
    !

    section "Predictive Maintenance"
        row
            make stat "Assets at Risk"  from risk_assets
            make stat "MTBF (Hours)"    from mtbf
            make stat "MTTR (Hours)"    from mttr
            make stat "Overall Health"  from health rounded to 1
        !
    !

!

# ═════════════════════════════════════════════════════════════════
#   PAGE 4 — FINANCIALS & FORECASTS
# ═════════════════════════════════════════════════════════════════

make page saved as "pitch_financials.html" styled as "dark"

    heading "Executive Financial Summary"
    subheading "Quarterly Revenue & Margin Trajectory"
    paragraph "Financial performance overlaid with operational efficiency savings."
    divider

    section "Quarterly Snapshot (in Millions)"
        row
            make stat "Q1 Revenue" from rev_q1 rounded to 1
            make stat "Q2 Revenue" from rev_q2 rounded to 1
            make stat "Q3 Revenue" from rev_q3 rounded to 1
            make stat "Q4 Revenue" from rev_q4 rounded to 1
        !
    !

    section "Revenue & Margin Trajectory"
        make line chart for x axis as quarters and y axis as rev_trend titled "Gross Revenue Trend ($M)"
        make bar chart for x axis as quarters and y axis as margins titled "Operating Margin (%)"
    !

!