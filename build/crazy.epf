    paragraph "<style>.epl-page{max-width:1100px!important;margin:0 auto;padding:2rem 2rem 6rem;}</style>"

    paragraph "<style>.nav-brand{font-weight:700;font-size:1.2rem;letter-spacing:0.1em;color:#fff;}</style>"
    paragraph "<style>.nav-status{color:#666;font-size:0.9rem;}</style>"
    paragraph "<style>.pulse{background:#fff!important;box-shadow:0 0 10px #fff!important;}</style>"
    paragraph "<span style='position:fixed;top:18px;left:50%;transform:translateX(-50%);z-index:9999;display:flex;gap:3rem;'>"
    paragraph "<a href='epl_landing.html' style='color:#fff;text-decoration:none;'>Home</a>"
    paragraph "<a href='epl_architecture.html' style='color:#fff;text-decoration:none;'>Architecture</a>"
    paragraph "<a href='epl_signup.html' style='color:#fff;text-decoration:none;'>Early Access</a>"
    paragraph "</span>"

    paragraph "<style>.card{background:#050505;padding:2.5rem;border-radius:12px;border:1px solid #222;text-align:left;transition:all 0.3s;}</style>"
    paragraph "<style>.card:hover{background:#111;border-color:#555;transform:translateY(-5px);}</style>"
    paragraph "<style>.card h3{color:#fff;margin-top:0;font-size:1.4rem;margin-bottom:1rem;font-weight:600;}</style>"
    paragraph "<style>.card p{color:#888;font-size:1.05rem;line-height:1.6;margin:0;}</style>"
    paragraph "<style>.epl-row{grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:2.5rem;margin-bottom:2rem;display:grid;}</style>"

    paragraph "<div style='padding:5rem 0 3rem;text-align:center;'><h1 style='font-size:4rem;margin-bottom:1rem;color:#fff;'>Architecture Deep Dive</h1><p style='color:#888;font-size:1.3rem;'>Explore the compilation pipeline and performance metrics.</p></div>"

    paragraph "<span class='epl-row'>"
    paragraph "<span class='card'><h3>The Lexer Engine</h3><p>A multi-word greedy matcher that supports natural spaces inside keywords. Extremely fast tokenization.</p></span>"
    paragraph "<span class='card'><h3>AST Generation</h3><p>Pure C recursive descent parser builds complex memory-safe Abstract Syntax Trees without dependencies.</p></span>"
    paragraph "</span>"

    paragraph "<span class='epl-row'>"
    paragraph "<span class='card'><h3>Manifest Tracker</h3><p>Every EPF project tracks its generated files via an .epbind manifest, preventing namespace collision.</p></span>"
    paragraph "<span class='card'><h3>Native 3D Orbital Engine</h3><p>EPL can compile canvas3d syntax into three.js visualizations, bridging logic and WebGL instantly.</p></span>"
    paragraph "</span>"

    paragraph "<h2 style='font-size:2rem;color:#fff;margin:3rem 0 1rem;'>Compilation Latency (ms)</h2>"
    paragraph "<div style='background:#111;padding:2rem;border-radius:12px;border:1px solid #222;'><canvas id='cC' style='height:400px;width:100%;'></canvas></div>"
    paragraph "<script>setTimeout(()=>{new Chart(document.getElementById('cC'),{type:'line',data:{labels:['L','P','A','C','L'],datasets:[{data:[1,3,1,5,1],borderColor:'#0ff',backgroundColor:'#0ff3',fill:true,tension:.4}]}})},1)</script>"

!

