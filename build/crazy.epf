    paragraph "<style>.cta-button{display:inline-block;background:#fff;color:#000;padding:1rem 2.5rem;border-radius:30px;font-size:1.1rem;font-weight:600;transition:all 0.2s;cursor:pointer;text-decoration:none;}</style>"
    paragraph "<style>.cta-button:hover{transform:translateY(-3px);box-shadow:0 4px 20px rgba(255,255,255,0.4);}</style>"
    paragraph "<style>.cta-button:active{transform:translateY(0) scale(0.98);}</style>"

    paragraph "<style>input{box-sizing:border-box;width:100%;padding:1rem;margin-bottom:1.5rem;border-radius:6px;background:#050505;border:1px solid #333;color:#fff;outline:none;transition:border-color 0.2s;}</style>"
    paragraph "<style>input:focus{border-color:#22d3ee;}</style>"

    paragraph "<div style='padding:5rem 0 3rem;text-align:center;'><h1 style='font-size:4rem;margin-bottom:1rem;color:#fff;'>Join the Waitlist</h1><p style='color:#888;font-size:1.3rem;'>Get early access to the EPL v1.6 Core Compiler.</p></div>"

    paragraph "<div style='max-width:500px;margin:0 auto;background:#111;padding:3rem;border-radius:12px;border:1px solid #222;'>"
    
    paragraph "<label style='color:#888;font-size:0.9rem;margin-bottom:0.5rem;display:block;'>Full Name</label>"
    paragraph "<input type='text' id='name' placeholder='John Doe'>"
    
    paragraph "<label style='color:#888;font-size:0.9rem;margin-bottom:0.5rem;display:block;'>Email Address</label>"
    paragraph "<input type='email' id='mail' placeholder='john@company.com'>"
    
    paragraph "<label style='color:#888;font-size:0.9rem;margin-bottom:0.5rem;display:block;'>Mobile Number</label>"
    paragraph "<input type='tel' id='tel' placeholder='+1 (555) 000-0000' style='margin-bottom:2.5rem;'>"
    
    paragraph "<div id='btn' class='cta-button' style='width:100%;text-align:center;box-sizing:border-box;'>Request Access</div>"
    paragraph "<p id='msg' style='color:#22d3ee;text-align:center;margin-top:1.5rem;display:none;font-weight:600;'>Access Granted. Check your email inbox.</p>"
    
    paragraph "</div>"

    paragraph "<script>btn.onclick=()=>{if(mail.value.includes('@')){msg.style.display='block';btn.innerHTML='Sent!';}else{alert('Invalid Email');}}</script>"

